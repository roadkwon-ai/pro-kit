		"gstack": {
			"description": "제품 판단·디자인·실사용 QA. 전역 설치(Bun)",
			"hosts": {
				"claude-code": "full",
				"codex": "full"
			},
			"global": [
				{
					"name": "gstack(Claude)",
					"check": "test -d \"$HOME/.claude/skills/gstack/bin\"",
					"install": "command -v bun >/dev/null || { echo 'gstack 설치에는 bun이 필요하다: https://bun.sh'; exit 1; }; git clone --single-branch --depth 1 https://github.com/garrytan/gstack.git \"$HOME/.claude/skills/gstack\" && cd \"$HOME/.claude/skills/gstack\" && ./setup",
					"hint": "pnpm skills:setup --brain gstack (bun 필요) 또는 https://github.com/garrytan/gstack",
					"tool": "claude"
				},
				{
					"name": "gstack(Codex)",
					"check": "test -d \"$HOME/.codex/skills/gstack\"",
					"install": "test -x \"$HOME/.claude/skills/gstack/setup\" && cd \"$HOME/.claude/skills/gstack\" && ./setup --host codex",
					"hint": "pnpm skills:setup --brain gstack (gstack(Claude) 설치 뒤)",
					"tool": "codex"
				}
			],
			"userSkills": ".claude/skills/gstack",
			"userTraces": [
				{
					"path": ".codex/skills/gstack"
				}
			]
		},
