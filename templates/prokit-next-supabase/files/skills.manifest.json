	"claude": {
		"marketplaces": {
			"claude-plugins-official": {
				"source": "github",
				"repo": "anthropics/claude-plugins-official"
			},
			"omc": {
				"source": "git",
				"url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
			},
			"ponytail": {
				"source": "github",
				"repo": "DietrichGebert/ponytail"
			}
		},
		"plugins": [
			"superpowers@claude-plugins-official",
			"skill-creator@claude-plugins-official",
			"oh-my-claudecode@omc",
			"ponytail@ponytail"
		]
	},
	"omx": ["setup", "--scope", "project", "--no-merge-agents"],
	"global": [
		{
			"name": "OMX CLI",
			"check": "command -v omx",
			"install": "npm install -g oh-my-codex"
		},
		{
			"name": "gstack(Claude)",
			"check": "test -d \"$HOME/.claude/skills/gstack/bin\"",
			"install": "command -v bun >/dev/null || { echo 'gstack 설치에는 bun이 필요하다: https://bun.sh'; exit 1; }; git clone --single-branch --depth 1 https://github.com/garrytan/gstack.git \"$HOME/.claude/skills/gstack\" && cd \"$HOME/.claude/skills/gstack\" && ./setup",
			"hint": "pnpm skills:setup --with-global (bun 필요) 또는 https://github.com/garrytan/gstack"
		},
		{
			"name": "gstack(Codex)",
			"check": "test -d \"$HOME/.codex/skills/gstack\"",
			"install": "test -x \"$HOME/.claude/skills/gstack/setup\" && cd \"$HOME/.claude/skills/gstack\" && ./setup --host codex",
			"hint": "pnpm skills:setup --with-global (gstack(Claude) 설치 뒤)"
		},
		{
			"name": "agent-browser CLI(npm 최신판)",
			"check": "v=$(agent-browser --version 2>/dev/null | awk '{print $2}'); want=$(npm view agent-browser version --fetch-timeout=5000 --fetch-retries=0 2>/dev/null); want=${want:-0.31.1}; [ -n \"$v\" ] && [ \"$(printf '%s\\n' \"$want\" \"$v\" | sort -V | head -n1)\" = \"$want\" ]",
			"install": "if brew list agent-browser >/dev/null 2>&1; then brew upgrade agent-browser; else npm install -g agent-browser@latest; fi && agent-browser install",
			"hint": "npm install -g agent-browser@latest && agent-browser install (Homebrew 설치본은 brew upgrade agent-browser. 올린 뒤에도 남으면 PATH 앞쪽의 다른 설치본(command -v agent-browser)을 지운다)",
			"auto": true
		},
		{
			"name": "Vercel CLI",
			"check": "command -v vercel",
			"install": "npm install -g vercel"
		},
		{
			"name": "ego-browser",
			"check": "command -v ego-browser",
			"hint": "https://lite.ego.app/ 에서 ego lite(macOS 앱)를 설치하고 첫 실행 설정을 마친다"
		},
		{
			"name": "Supabase CLI",
			"check": "command -v supabase",
			"install": "command -v brew >/dev/null || { echo 'Homebrew가 없다. 설치 없이 쓰려면 pnpm dlx supabase@latest <명령>'; exit 1; }; brew install supabase/tap/supabase",
			"hint": "brew install supabase/tap/supabase 또는 pnpm dlx supabase@latest <명령>"
		}
	]
}
