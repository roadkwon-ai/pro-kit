		"openspec": {
			"description": "변경마다 제안·설계·작업 목록을 먼저 합의하는 가벼운 스펙 주도형. 전역 CLI(npm)",
			"hosts": {
				"claude-code": "full",
				"codex": "full"
			},
			"global": [
				{
					"name": "OpenSpec CLI",
					"check": "command -v openspec >/dev/null",
					"install": "npm install -g @fission-ai/openspec@latest",
					"hint": "pnpm skills:setup --brain openspec (npm 전역 설치) 또는 https://github.com/Fission-AI/OpenSpec"
				}
			],
			"init": {
				"run": "openspec init --tools claude,codex,antigravity --force --profile core --no-animation",
				"env": {
					"OPENSPEC_TELEMETRY": "0"
				},
				"marker": [
					".claude/skills/openspec-propose/SKILL.md",
					".agents/skills/openspec-propose/SKILL.md"
				],
				"remove": "rm -rf .claude/skills/openspec-* .agents/skills/openspec-* .agents/skills/.openspec-target .claude/commands/opsx .agents/workflows/opsx-*.md",
				"keep": ["openspec"]
			}
		},
		"spec-kit": {
			"description": "헌법·스펙·계획·작업 목록을 차례로 쓰는 GitHub의 꼼꼼한 스펙 주도형. 설치에 uv 필요",
			"hosts": {
				"claude-code": "full",
				"codex": "full"
			},
			"init": {
				"run": "command -v uvx >/dev/null || { echo 'spec-kit 설치에는 uv가 필요하다: https://docs.astral.sh/uv/getting-started/installation/'; exit 1; }; uvx --from specify-cli specify init --here --force --non-interactive --integration claude --integration-options='--events false' --script sh --ignore-agent-tools && uvx --from specify-cli specify integration install codex --integration-options='--events false'",
				"marker": [
					".claude/skills/speckit-specify/SKILL.md",
					".agents/skills/speckit-specify/SKILL.md"
				],
				"remove": "rm -rf .claude/skills/speckit-* .agents/skills/speckit-* .specify/scripts .specify/templates .specify/workflows .specify/integrations .specify/integration.json .specify/init-options.json .specify/feature.json .specify/.gitignore",
				"keep": ["specs", ".specify/memory"]
			}
		},
