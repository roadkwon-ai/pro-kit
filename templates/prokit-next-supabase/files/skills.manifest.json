				"source": "github",
				"repo": "anthropics/claude-plugins-official"
			}
		},
		"plugins": ["skill-creator@claude-plugins-official"],
		"conflicts": {
			"frontend-design@claude-plugins-official": "UI 스킬과 같은 일(impeccable이 이 스킬에서 출발했다). UI 스킬이 없으면(none) skills CLI로 받은 frontend-design을 쓴다",
			"hallmark@hallmark": "UI 스킬 hallmark의 Claude 플러그인판(이 프로젝트는 고른 UI 스킬을 skills CLI 설치본으로만 쓴다)"
		}
	},
	"global": [
		{
			"name": "agent-browser CLI(npm 최신판)",
			"check": "v=$(agent-browser --version 2>/dev/null | awk '{print $2}'); want=$(npm view agent-browser version --fetch-timeout=5000 --fetch-retries=0 2>/dev/null); want=${want:-0.31.1}; [ -n \"$v\" ] && [ \"$(printf '%s\\n' \"$want\" \"$v\" | sort -V | head -n1)\" = \"$want\" ]",
			"install": "if brew list agent-browser >/dev/null 2>&1; then brew upgrade agent-browser; else npm install -g agent-browser@latest; fi && agent-browser install",
			"hint": "npm install -g agent-browser@latest && agent-browser install (Homebrew 설치본은 brew upgrade agent-browser. 올린 뒤에도 남으면 PATH 앞쪽의 다른 설치본(command -v agent-browser)을 지운다)",
			"auto": true
		},
		{
			"name": "Vercel CLI",
			"check": "command -v vercel",
			"install": "npm install -g vercel"
		},
		{
			"name": "ego-browser",
			"check": "command -v ego-browser",
			"hint": "https://lite.ego.app/ 에서 ego lite(macOS 앱)를 설치하고 첫 실행 설정을 마친다"
		},
		{
			"name": "Supabase CLI",
			"check": "command -v supabase",
			"install": "command -v brew >/dev/null || { echo 'Homebrew가 없다. 설치 없이 쓰려면 pnpm dlx supabase@latest <명령>'; exit 1; }; brew install supabase/tap/supabase",
			"hint": "brew install supabase/tap/supabase 또는 pnpm dlx supabase@latest <명령>"
		}
	]
}
