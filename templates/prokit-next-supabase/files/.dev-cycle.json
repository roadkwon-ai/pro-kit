{
	"brain": "none",
	"simplicity": "none",
	"uiSkill": "impeccable",
	"todoPath": "tasks/todo.md",
	"archiveDir": "tasks/archive",
	"workflowDoc": "docs/dev-workflow.md",
	"defaultBranch": "main",
	"rules": [
		{
			"case": "E",
			"match": "^packages/db/",
			"why": "DB 스키마·마이그레이션·연결"
		},
		{
			"case": "D",
			"match": "^(packages/api/|apps/web/src/app/api/|apps/web/src/app/(.+/)?(route|sitemap|robots|manifest)\\.[jt]sx?$|apps/web/src/(.+/)?actions?\\.[jt]s$|apps/web/src/instrumentation\\.[jt]s$)",
			"why": "서버·API(앱 폴더의 route 핸들러·메타데이터 라우트, 서버 액션 파일 actions.ts, instrumentation 포함)"
		},
		{
			"case": "B",
			"match": "^(apps/web/src/|packages/ui/)",
			"why": "화면·UI"
		},
		{
			"case": "H",
			"match": "^(AGENTS\\.md$|CLAUDE\\.md$|\\.agents/(skills|agents)/|\\.claude/(agents|skills)/|\\.claude/settings\\.json$|\\.(agents|codex)/hooks\\.json$|\\.codex/(agents|skills|prompts)/|skills-lock\\.json$|skills\\.manifest\\.json$|scripts/(dev-cycle|sync-agents|skills-setup|vercel-deploy|release|resource-guard|delegation|export-html|load-keys)\\.mjs$|\\.dev-cycle\\.json$|\\.vercelignore$|docs/dev-workflow\\.md$)",
			"why": "하네스"
		},
		{
			"case": "H",
			"match": "^((apps/web/)?next\\.config\\.(ts|mts|js|mjs|cjs)$|(apps/web/)?vercel\\.(json|ts)$|\\.github/(workflows|actions)/|(apps/web/)?turbo\\.json$)",
			"why": "빌드·배포 설정"
		},
		{
			"case": "H",
			"match": "^(package\\.json|biome\\.jsonc?|tsconfig\\.json|packages/config/)",
			"why": "작업공간 설정"
		}
	],
	"authPaths": "^(packages/auth/|apps/web/src/app/api/auth/|apps/web/src/lib/auth-client\\.ts$|apps/web/src/(proxy|middleware|services|context|env\\.server)\\.ts$|packages/api/src/(index|context)\\.ts$|packages/db/src/schema/auth\\.ts$|(.*/)?\\.env\\.schema$)",
	"ui": { "auditMin": 16, "a11yMin": 3 },
	"commands": {},
	"resources": {
		"roots": []
	}
}
